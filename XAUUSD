function loadStates() {
    try {
        var saved = localStorage.getItem('grid_xauusd_states_v1');
        if (!saved) return;
        var data = JSON.parse(saved);
        Object.keys(data).forEach(function(id){
            if (!strategyStates[id]) return;
            var s = strategyStates[id], d = data[id];
            s.running = false; // 刷新后不自动运行，需手动启动
            s.usdtPoints = d.usdtPoints !== undefined ? d.usdtPoints : INITIAL_USDT_POINTS;
            s.xauPoints = d.xauPoints || 0;
            s.avgCost = d.avgCost || 0;
            if (d.params) {
                Object.keys(s.params).forEach(function(k){
                    if (d.params[k] && d.params[k].value !== undefined) s.params[k].value = d.params[k].value;
                });
            }
            s.logs = d.logs || [];
            s.orders = d.orders || [];
            s.totalTrades = d.totalTrades || 0;
            s.winTrades = d.winTrades || 0;
            s.lossTrades = d.lossTrades || 0;
            s.maxDrawdown = d.maxDrawdown || 0;
            s.peakValue = d.peakValue || INITIAL_USDT_POINTS;
            s.initialValue = d.initialValue || INITIAL_USDT_POINTS;
            s.lastPrice = d.lastPrice || 0;
            s.gridLevel = d.gridLevel || 0;
            s.periodStats = d.periodStats || s.periodStats;
            s.priceHistory = d.priceHistory || [];
            s.latestKline = d.latestKline || null;
            s.indicatorState = d.indicatorState || s.indicatorState;
        });
    } catch(e) { console.error('加载失败', e); }
}

