        if (!input) return;
        var v = parseFloat(input.value);
        if (isNaN(v)) { errors.push(st.params[k].label + ' 非法'); return; }
        st.params[k].value = v;
    });
    if (st.params.gridUpper.value <= st.params.gridLower.value) errors.push('网格上限必须大于下限');
    if (st.params.gridSpacing.value <= 0) errors.push('网格间距必须大于0');
    if (st.params.gridLevels.value < 1) errors.push('最大层数必须≥1');
    if (st.params.positionSize.value <= 0 || st.params.positionSize.value > 100) errors.push('单格仓位须在(0,100]');
    if (errors.length) { alert('参数错误：\n' + errors.join('\n')); return; }
    st.lastPrice = 0; st.gridLevel = 0;
    addLog(currentEditingStrategy, '⚙️ 参数已更新');
    closeParamsModal();
    renderStrategyCards();
}

function openLogModal(id) {
    var st = strategyStates[id];
    var strategy = strategies.find(function(s){ return s.id === id; });
    document.getElementById('logModalTitle').textContent = '📋 ' + strategy.name + ' - 日志';
    document.getElementById('logBoxContent').textContent = st.logs.length ? st.logs.join('\n') : '暂无日志';
    document.getElementById('logModalOverlay').classList.add('show');
}
function closeLogModal(){ document.getElementById('logModalOverlay').classList.remove('show'); }

function openOrdersModal(id) {
    var st = strategyStates[id];
    var strategy = strategies.find(function(s){ return s.id === id; });
    document.getElementById('ordersModalTitle').textContent = '📋 ' + strategy.name + ' - 订单';
    var tbody = document.getElementById('ordersTableBody');
    if (!st.orders.length) {
        tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;padding:20px;color:#5a5a6a;">暂无订单</td></tr>';
    } else {
        var html = '';
        for (var i = st.orders.length - 1; i >= 0; i--) {
            var o = st.orders[i];
            var d = new Date(o.timestamp);
            var sideColor = o.side === 'buy' ? '#10b981' : '#ef4444';
            var sideText = o.side === 'buy' ? '买入' : '卖出';
            var pnlColor = o.pnl >= 0 ? '#10b981' : '#ef4444';
            html += '<tr><td style="color:' + sideColor + ';">' + sideText + '</td><td>' + o.pair + '</td><td style="text-align:right;">$' + o.price.toFixed(2) + '</td><td style="text-align:right;">' + o.quantity.toFixed(3) + '</td><td style="text-align:right;">' + o.amountPoints.toFixed(2) + '</td><td style="text-align:right;color:' + pnlColor + ';">' + (o.pnl >= 0 ? '+' : '') + o.pnl.toFixed(2) + '</td><td style="text-align:right;">' + d.toLocaleTimeString() + '</td></tr>';
        }
        tbody.innerHTML = html;
    }
    document.getElementById('ordersModalOverlay').classList.add('show');
}
function closeOrdersModal(){ document.getElementById('ordersModalOverlay').classList.remove('show'); }

function openKnowledgePanel(){ document.getElementById('strategyKnowledgeOverlay').classList.add('show'); document.body.style.overflow = 'hidden'; }
function closeKnowledgePanel(){ document.getElementById('strategyKnowledgeOverlay').classList.remove('show'); document.body.style.overflow = ''; }

// ===================== 初始化 =====================
document.addEventListener('DOMContentLoaded', function(){
    document.getElementById('apiKeyInput').value = TWELVEDATA_KEY || '';
    loadStates();
    renderStrategyCards();

    if (TWELVEDATA_KEY) {
        fetchKlinesAndApply();
        setInterval(fetchKlinesAndApply, KLINE_REFRESH_MS);
    } else {
        document.getElementById('apiStatus').textContent = '⚠️ 请输入 Twelve Data API Key 后点击保存（免费注册 twelvedata.com）';
    }

    // 点击遮罩关闭
    ['paramsModalOverlay','logModalOverlay','ordersModalOverlay','strategyKnowledgeOverlay'].forEach(function(id){
        var el = document.getElementById(id);
        if (el) el.addEventListener('click', function(e){ if (e.target === this) this.classList.remove('show'); });
    });

    // 暴露到 window
    window.saveApiKey = saveApiKey;
    window.toggleStrategy = toggleStrategy;
    window.resetStrategy = resetStrategy;
    window.openParamsModal = openParamsModal;
    window.closeParamsModal = closeParamsModal;
    window.saveParams = saveParams;
    window.openLogModal = openLogModal;
    window.closeLogModal = closeLogModal;
    window.openOrdersModal = openOrdersModal;
    window.closeOrdersModal = closeOrdersModal;
    window.openKnowledgePanel = openKnowledgePanel;
    window.closeKnowledgePanel = closeKnowledgePanel;
});
</script>
</body>
</html>
