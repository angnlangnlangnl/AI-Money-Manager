<script>
// ============================================================
//  配置区（XAUUSD + Twelve Data）
// ============================================================
var INITIAL_USDT_POINTS = 100000;
var INITIAL_XAU_POINTS = 0;
var SYMBOL = 'XAUUSD';
var SYMBOL_API = 'XAU/USD';
var KLINE_INTERVAL = '1min';
var KLINE_OUTPUTSIZE = 200;
var KLINE_REFRESH_MS = 60 * 1000;
var FALLBACK_PRICE = 2350.00;
var pairPrices = { 'XAUUSD': FALLBACK_PRICE };

var TWELVEDATA_KEY = localStorage.getItem('twelvedata_key') || '';

var strategies = [
    { id: 'rsi', icon: '📈', name: 'RSI网格策略', badge: 'RSI', description: '基于RSI超买超卖信号的网格交易', signals: ['超卖买入', '超买卖出', '中性持有'],
      params: { rsiPeriod:{label:'RSI周期',value:14}, oversold:{label:'超卖阈值',value:30}, overbought:{label:'超买阈值',value:70}, gridSpacing:{label:'网格间距(USD/格)',value:5}, positionSize:{label:'单格仓位(%)',value:10} } },
    { id: 'bollinger', icon: '📊', name: '布林带网格策略', badge: 'BOLL', description: '基于布林带上下轨的均值回归网格', signals: ['下轨买入', '上轨卖出', '中轨平仓'],
      params: { bbPeriod:{label:'布林带周期',value:20}, stdDev:{label:'标准差倍数',value:2}, gridSpacing:{label:'网格间距(USD/格)',value:4}, positionSize:{label:'单格仓位(%)',value:8} } },
    { id: 'ema', icon: '📉', name: 'EMA趋势网格策略', badge: 'EMA', description: 'EMA趋势过滤+动态网格', signals: ['金叉买入', '死叉卖出', '趋势过滤'],
      params: { emaShort:{label:'EMA短期',value:20}, emaLong:{label:'EMA长期',value:50}, gridSpacing:{label:'网格间距(USD/格)',value:5}, positionSize:{label:'单格仓位(%)',value:10}, stopLoss:{label:'止损(%)',value:5} } },
    { id: 'kdj', icon: '📐', name: 'KDJ网格策略', badge: 'KDJ', description: 'KDJ指标+网格交易', signals: ['K上穿D买入', 'K下穿D卖出', 'J值超买超卖'],
      params: { kdjPeriod:{label:'KDJ周期',value:9}, kParam:{label:'K值参数',value:3}, dParam:{label:'D值参数',value:3}, gridSpacing:{label:'网格间距(USD/格)',value:5}, positionSize:{label:'单格仓位(%)',value:8} } },
    { id: 'macd', icon: '📋', name: 'MACD网格策略', badge: 'MACD', description: 'MACD趋势判断+网格执行', signals: ['MACD金叉买入', 'MACD死叉卖出', '柱状图缩量'],
      params: { fastPeriod:{label:'快线周期',value:12}, slowPeriod:{label:'慢线周期',value:26}, signalPeriod:{label:'信号周期',value:9}, gridSpacing:{label:'网格间距(USD/格)',value:5}, positionSize:{label:'单格仓位(%)',value:10} } },
    { id: 'multi', icon: '🔄', name: '多周期网格策略', badge: 'MULTI', description: '长周期EMA趋势过滤+网格执行', signals: ['趋势判断', '网格区间', '指标确认'],
      params: { trendPeriod:{label:'趋势周期(小时)',value:4}, gridSpacing:{label:'网格间距(USD/格)',value:4}, positionSize:{label:'单格仓位(%)',value:8}, maxPositions:{label:'最大持仓(%)',value:60} } }
];

// 为所有策略追加通用网格参数（黄金默认区间 2300-2500）
strategies.forEach(function(s){
    s.params.gridUpper = { label:'网格上限(USD)', value:2500 };
    s.params.gridLower = { label:'网格下限(USD)', value:2300 };
    s.params.gridLevels = { label:'最大网格层数', value:40 };
});

var strategyStates = {};
strategies.forEach(function(s){
    strategyStates[s.id] = {
        running: false,
        usdtPoints: INITIAL_USDT_POINTS,
        xauPoints: INITIAL_XAU_POINTS,
        avgCost: 0,
        interval: null,
        params: JSON.parse(JSON.stringify(s.params)),
        logs: [],
        orders: [],
        totalTrades: 0,
        winTrades: 0,
        lossTrades: 0,
        maxDrawdown: 0,
        peakValue: INITIAL_USDT_POINTS,
        initialValue: INITIAL_USDT_POINTS,
        lastPrice: 0,
        gridLevel: 0,
        priceHistory: [],
        latestKline: null,
        periodStats: {
            '1d': { pnl:0, trades:0, lastReset: Date.now() },
            '1w': { pnl:0, trades:0, lastReset: Date.now() },
            '1m': { pnl:0, trades:0, lastReset: Date.now() },
            'all': { pnl:0, trades:0 }
        },
        indicatorState: {
            emaShort: null, emaLong: null, prevEmaShort: null, prevEmaLong: null,
            prevK: 50, prevD: 50, prevK_before: 50, prevD_before: 50,
            macdDif: [], prevHist: null, macdCross: null, cross: null
        }
    };
});

var currentEditingStrategy = null;

// ===================== 指标计算 =====================
function calculateSMA(prices, period) {
    if (prices.length < period) return null;
    var sum = 0;
    for (var i = prices.length - period; i < prices.length; i++) sum += prices[i];
    return sum / period;
}
function calculateEMA(prices, period) {
    if (prices.length < period) return null;
    var k = 2 / (period + 1);
    var ema = calculateSMA(prices.slice(0, period), period);
    if (ema === null) return null;
    for (var i = period; i < prices.length; i++) ema = prices[i] * k + ema * (1 - k);
    return ema;
}
function calculateRSI(prices, period) {
    if (prices.length < period + 1) return null;
    var gains = 0, losses = 0;
    for (var i = prices.length - period; i < prices.length; i++) {
        var diff = prices[i] - prices[i-1];
        if (diff >= 0) gains += diff; else losses -= diff;
    }
    if (losses === 0) return 100;
    return 100 - (100 / (1 + gains / losses));
}
function calculateBollinger(prices, period, mult) {
    if (prices.length < period) return null;
    var slice = prices.slice(-period);
    var mean = slice.reduce(function(a,b){return a+b;},0) / period;
    var variance = slice.reduce(function(a,b){return a + Math.pow(b-mean,2);},0) / period;
    var std = Math.sqrt(variance);
    return { upper: mean + mult*std, lower: mean - mult*std, middle: mean };
}

// ===================== 指标状态更新 =====================
function updateEmaIndicator(state) {
    var shortEma = calculateEMA(state.priceHistory, state.params.emaShort.value);
    var longEma = calculateEMA(state.priceHistory, state.params.emaLong.value);
    if (shortEma === null || longEma === null) {
        state.indicatorState.emaShort = shortEma;
        state.indicatorState.emaLong = longEma;
        state.indicatorState.cross = null;
        return;
    }
    var prevShort = state.indicatorState.emaShort;
    var prevLong = state.indicatorState.emaLong;
    state.indicatorState.emaShort = shortEma;
    state.indicatorState.emaLong = longEma;
    if (prevShort !== null && prevLong !== null) {
        if (prevShort <= prevLong && shortEma > longEma) state.indicatorState.cross = 'golden';
        else if (prevShort >= prevLong && shortEma < longEma) state.indicatorState.cross = 'death';
        else state.indicatorState.cross = null;
    } else {
        state.indicatorState.cross = null;
    }
}
function updateKdjIndicator(state) {
    var period = state.params.kdjPeriod.value;
    if (state.priceHistory.length < period) return;
    var slice = state.priceHistory.slice(-period);
    var highest = Math.max.apply(null, slice);
    var lowest = Math.min.apply(null, slice);
    if (highest === lowest) return;
    var rsv = (state.priceHistory[state.priceHistory.length - 1] - lowest) / (highest - lowest) * 100;
    var prevK = state.indicatorState.prevK === null ? 50 : state.indicatorState.prevK;
    var prevD = state.indicatorState.prevD === null ? 50 : state.indicatorState.prevD;
    var k = (2/3) * prevK + (1/3) * rsv;
    var d = (2/3) * prevD + (1/3) * k;
    state.indicatorState.prevK_before = prevK;
    state.indicatorState.prevD_before = prevD;
    state.indicatorState.prevK = k;
    state.indicatorState.prevD = d;
}
function updateMacdIndicator(state) {
    var fast = state.params.fastPeriod.value;
    var slow = state.params.slowPeriod.value;
    var signal = state.params.signalPeriod.value;
    if (state.priceHistory.length < slow + signal) return;
    // 逐根计算 DIF 序列，保证回放一致
    var difSeries = [];
    for (var i = slow; i <= state.priceHistory.length; i++) {
        var slice = state.priceHistory.slice(0, i);
        var f = calculateEMA(slice, fast);
        var s = calculateEMA(slice, slow);
        if (f !== null && s !== null) difSeries.push(f - s);
    }
    if (difSeries.length < signal) return;
    state.indicatorState.macdDif = difSeries.slice(-200);
    var dea = calculateEMA(state.indicatorState.macdDif, signal);
    if (dea === null) return;
    var dif = state.indicatorState.macdDif[state.indicatorState.macdDif.length - 1];
    var hist = dif - dea;
    var prevHist = state.indicatorState.prevHist;
    state.indicatorState.prevHist = hist;
    if (prevHist !== null && prevHist !== undefined) {
        if (prevHist <= 0 && hist > 0) state.indicatorState.macdCross = 'golden';
        else if (prevHist >= 0 && hist < 0) state.indicatorState.macdCross = 'death';
        else state.indicatorState.macdCross = null;
    }
}

function resetIndicatorState(st) {
    st.indicatorState = {
        emaShort: null, emaLong: null, prevEmaShort: null, prevEmaLong: null,
        prevK: 50, prevD: 50, prevK_before: 50, prevD_before: 50,
        macdDif: [], prevHist: null, macdCross: null, cross: null
    };
}
function computeIndicatorOnSlice(strategyId, st, slice) {
    var saved = st.priceHistory;
    st.priceHistory = slice;
    switch (strategyId) {
        case 'ema': updateEmaIndicator(st); break;
        case 'kdj': updateKdjIndicator(st); break;
        case 'macd': updateMacdIndicator(st); break;
        default: break;
    }
    st.priceHistory = saved;
}

// ===================== 信号函数 =====================
function rsiBuySignal(state){ var r=calculateRSI(state.priceHistory, state.params.rsiPeriod.value); return r!==null && r<state.params.oversold.value; }
function rsiSellSignal(state){ var r=calculateRSI(state.priceHistory, state.params.rsiPeriod.value); return r!==null && r>state.params.overbought.value; }
function bollingerBuySignal(state, p){ var b=calculateBollinger(state.priceHistory, state.params.bbPeriod.value, state.params.stdDev.value); return b && p<=b.lower*1.002; }
function bollingerSellSignal(state, p){ var b=calculateBollinger(state.priceHistory, state.params.bbPeriod.value, state.params.stdDev.value); return b && p>=b.upper*0.998; }
function emaBuySignal(state){ return state.indicatorState.cross==='golden'; }
function emaSellSignal(state){ return state.indicatorState.cross==='death'; }
function kdjBuySignal(state){ var pk=state.indicatorState.prevK_before, pd=state.indicatorState.prevD_before, k=state.indicatorState.prevK, d=state.indicatorState.prevD; return pk!==undefined && pd!==undefined && pk<=pd && k>d; }
function kdjSellSignal(state){ var pk=state.indicatorState.prevK_before, pd=state.indicatorState.prevD_before, k=state.indicatorState.prevK, d=state.indicatorState.prevD; return pk!==undefined && pd!==undefined && pk>=pd && k<d; }
function macdBuySignal(state){ return state.indicatorState.macdCross==='golden'; }
function macdSellSignal(state){ return state.indicatorState.macdCross==='death'; }
function multiBuySignal(state, p){ var ema=calculateEMA(state.priceHistory, Math.max(5, state.params.trendPeriod.value*4)); return ema!==null && p>ema; }
function multiSellSignal(state, p){ var ema=calculateEMA(state.priceHistory, Math.max(5, state.params.trendPeriod.value*4)); return ema!==null && p<ema; }

function shouldBuy(id, p) {
    var st = strategyStates[id];
    switch (id) {
        case 'rsi': return rsiBuySignal(st);
        case 'bollinger': return bollingerBuySignal(st, p);
        case 'ema': return emaBuySignal(st);
        case 'kdj': return kdjBuySignal(st);
        case 'macd': return macdBuySignal(st);
        case 'multi': return multiBuySignal(st, p);
        default: return true;
    }
}
function shouldSell(id, p) {
    var st = strategyStates[id];
    switch (id) {
        case 'rsi': return rsiSellSignal(st);
        case 'bollinger': return bollingerSellSignal(st, p);
        case 'ema': return emaSellSignal(st);
        case 'kdj': return kdjSellSignal(st);
        case 'macd': return macdSellSignal(st);
        case 'multi': return multiSellSignal(st, p);
        default: return true;
    }
}

