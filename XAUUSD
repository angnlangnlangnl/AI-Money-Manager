function getPnlInfo(st) {
    var price = pairPrices['XAUUSD'] || 0;
    var totalValue = st.usdtPoints + st.xauPoints * price;
    var pnl = totalValue - st.initialValue;
    if (totalValue > st.peakValue) st.peakValue = totalValue;
    var dd = st.peakValue > 0 ? (st.peakValue - totalValue) / st.peakValue * 100 : 0;
    if (dd > st.maxDrawdown) st.maxDrawdown = dd;
    return { totalValue: totalValue, pnl: pnl, returnPct: (totalValue - st.initialValue) / st.initialValue * 100 };
}

