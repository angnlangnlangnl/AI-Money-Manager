function saveApiKey() {
    var v = document.getElementById('apiKeyInput').value.trim();
    if (!v) { alert('请输入 API Key'); return; }
    TWELVEDATA_KEY = v;
    localStorage.setItem('twelvedata_key', v);
    alert('✅ API Key 已保存，正在拉取 K线...');
    fetchKlinesAndApply();
}

function fetchKlinesAndApply() {
    if (!TWELVEDATA_KEY) {
        document.getElementById('apiStatus').textContent = '⚠️ 请先输入 Twelve Data API Key（免费注册 twelvedata.com）';
        document.getElementById('apiKeyInput').value = '';
        return;
    }
    var url = 'https://api.twelvedata.com/time_series'
        + '?symbol=' + encodeURIComponent(SYMBOL_API)
        + '&interval=' + KLINE_INTERVAL
        + '&outputsize=' + KLINE_OUTPUTSIZE
        + '&apikey=' + encodeURIComponent(TWELVEDATA_KEY);

    var controller = new AbortController();
    var timer = setTimeout(function(){ controller.abort(); }, 10000);

    fetch(url, { signal: controller.signal, cache: 'no-store' })
        .then(function(res){ if (!res.ok) throw new Error('HTTP ' + res.status); return res.json(); })
        .then(function(data){
            clearTimeout(timer);
            if (data.status === 'error' || !data.values || data.values.length === 0) {
                throw new Error(data.message || 'no kline data');
            }
            var bars = data.values.map(function(v){
                var tsStr = v.datetime.replace(' ', 'T') + 'Z';
                return { ts: new Date(tsStr).getTime(), open: parseFloat(v.open), high: parseFloat(v.high), low: parseFloat(v.low), close: parseFloat(v.close) };
            }).filter(function(b){ return isFinite(b.close) && b.close > 0; })
              .sort(function(a,b){ return a.ts - b.ts; });

            if (bars.length === 0) throw new Error('no valid bars');

            var latestPrice = bars[bars.length - 1].close;
            pairPrices['XAUUSD'] = latestPrice;

            strategies.forEach(function(s){
                var st = strategyStates[s.id];
                st.priceHistory = bars.map(function(b){ return b.close; });
                if (st.priceHistory.length > 200) st.priceHistory = st.priceHistory.slice(-200);
                st.latestKline = bars[bars.length - 1];

                // 整体回放指标状态
                resetIndicatorState(st);
                for (var i = 0; i < st.priceHistory.length; i++) {
                    computeIndicatorOnSlice(s.id, st, st.priceHistory.slice(0, i + 1));
                }
            });

            document.getElementById('apiStatus').textContent =
                '📡 XAUUSD K线已更新 (' + new Date().toLocaleTimeString() + ') $' + latestPrice.toFixed(2)
                + '  ' + KLINE_INTERVAL + ' × ' + bars.length + '根';

            updateRunningStrategies();
            renderStrategyCards();
        })
        .catch(function(err){
            clearTimeout(timer);
            document.getElementById('apiStatus').textContent =
                '⚠️ K线获取失败: ' + err.message + '（使用兜底价 $' + FALLBACK_PRICE.toFixed(2) + '）';
            pairPrices['XAUUSD'] = pairPrices['XAUUSD'] || FALLBACK_PRICE;
            renderStrategyCards();
        });
}

// ===================== 网格与交易 =====================
function calculateGridLevels(state) {
    var upper = state.params.gridUpper.value;
    var lower = state.params.gridLower.value;
    var step = state.params.gridSpacing.value;
    var maxLevels = state.params.gridLevels.value;
    if (upper <= lower || step <= 0) return 0;
    var levels = Math.floor((upper - lower) / step);
    if (levels < 1) levels = 1;
    if (maxLevels > 0 && levels > maxLevels) levels = maxLevels;
    return levels;
}

function checkGridAndTrade(strategyId) {
    var state = strategyStates[strategyId];
    var price = pairPrices['XAUUSD'];
    if (!price) return;

    // 止损：价格跌破均价指定比例
    if (state.xauPoints > 0 && state.avgCost > 0 && state.params.stopLoss) {
        var slPct = state.params.stopLoss.value / 100;
        if (price < state.avgCost * (1 - slPct)) {
            executeSell(strategyId, price, '止损触发');
            return;
        }
    }

    var levels = calculateGridLevels(state);
    if (levels <= 0) return;
    var upper = state.params.gridUpper.value;
    var lower = state.params.gridLower.value;
    var step = (upper - lower) / levels;
    if (step <= 0) return;
    if (price <= lower || price >= upper) return;

    var level = Math.floor((price - lower) / step);

    if (state.lastPrice === 0) {
        state.lastPrice = price;
        state.gridLevel = level;
        return;
    }

    var prevLevel = state.gridLevel;
    if (level !== prevLevel) {
        if (level < prevLevel) {
            if (shouldBuy(strategyId, price)) executeBuy(strategyId, price);
            else addLog(strategyId, '网格买入信号触发，指标未确认，跳过');
        } else {
            if (shouldSell(strategyId, price)) executeSell(strategyId, price);
            else addLog(strategyId, '网格卖出信号触发，指标未确认，跳过');
        }
        state.gridLevel = level;
    }
    state.lastPrice = price;
}

function updateRunningStrategies() {
    strategies.forEach(function(s){
        if (strategyStates[s.id].running && pairPrices['XAUUSD']) checkGridAndTrade(s.id);
    });
}

function executeBuy(strategyId, price) {
    var st = strategyStates[strategyId];
    var pct = st.params.positionSize.value / 100;
    var amount = st.usdtPoints * pct;
    if (amount < 10) return;
    var qty = amount / price;
    if (qty <= 0) return;

    var newQty = st.xauPoints + qty;
    st.avgCost = (st.avgCost * st.xauPoints + price * qty) / newQty;
    st.xauPoints = newQty;
    st.usdtPoints -= amount;
    st.totalTrades++;

    st.orders.push({
        id: 'ORD' + Date.now() + Math.floor(Math.random()*1000),
        side: 'buy', pair: SYMBOL, price: price, quantity: qty,
        amountPoints: amount, pnl: 0, timestamp: Date.now()
    });
    if (st.orders.length > 500) st.orders.shift();

    var totalValue = st.usdtPoints + st.xauPoints * price;
    if (totalValue > st.peakValue) st.peakValue = totalValue;
    addLog(strategyId, '📈 买入 ' + qty.toFixed(3) + ' oz @ $' + price.toFixed(2) + '，消耗积分 ' + amount.toFixed(2) + '，均价 $' + st.avgCost.toFixed(2));
}

function executeSell(strategyId, price, reason) {
    var st = strategyStates[strategyId];
    if (st.xauPoints <= 0.000001) return;
    var pct = st.params.positionSize.value / 100;
    var sellQty = st.xauPoints * pct;
    if (reason === '止损触发') sellQty = st.xauPoints; // 止损全平
    if (sellQty <= 0) return;

    var proceeds = sellQty * price;
    var pnlChange = (price - st.avgCost) * sellQty;

    st.xauPoints -= sellQty;
    st.usdtPoints += proceeds;
    st.totalTrades++;
    if (pnlChange >= 0) st.winTrades++; else st.lossTrades++;
    if (st.xauPoints < 0.000001) { st.xauPoints = 0; st.avgCost = 0; }

    st.orders.push({
        id: 'ORD' + Date.now() + Math.floor(Math.random()*1000),
        side: 'sell', pair: SYMBOL, price: price, quantity: sellQty,
        amountPoints: proceeds, pnl: pnlChange, timestamp: Date.now()
    });
    if (st.orders.length > 500) st.orders.shift();

    updatePeriodStats(st, pnlChange);
    var totalValue = st.usdtPoints + st.xauPoints * price;
    if (totalValue > st.peakValue) st.peakValue = totalValue;

    addLog(strategyId, '📉 卖出 ' + sellQty.toFixed(3) + ' oz @ $' + price.toFixed(2)
        + '，盈亏 ' + (pnlChange >= 0 ? '+' : '') + pnlChange.toFixed(2)
        + (reason ? '（' + reason + '）' : ''));
}

function updatePeriodStats(st, pnlChange) {
    var now = Date.now();
    var periods = { '1d': 86400000, '1w': 604800000, '1m': 2592000000 };
    Object.keys(periods).forEach(function(k){
        if (now - st.periodStats[k].lastReset > periods[k]) {
            st.periodStats[k].lastReset = now;
            st.periodStats[k].pnl = 0;
            st.periodStats[k].trades = 0;
        }
    });
    Object.keys(st.periodStats).forEach(function(k){
        st.periodStats[k].pnl += pnlChange;
        st.periodStats[k].trades++;
    });
}

function addLog(strategyId, msg) {
    var st = strategyStates[strategyId];
    st.logs.push('[' + new Date().toLocaleTimeString() + '] ' + msg);
    if (st.logs.length > 200) st.logs.shift();
    saveStates();
}

