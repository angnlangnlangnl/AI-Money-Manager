// ===================== 弹窗 =====================
function toggleStrategy(id) {
    var st = strategyStates[id];
    if (st.running) {
        st.running = false;
        if (st.interval) { clearInterval(st.interval); st.interval = null; }
        addLog(id, '策略已暂停');
    } else {
        st.running = true;
        st.lastPrice = 0;
        st.gridLevel = 0;
        addLog(id, '策略已启动，标的 XAUUSD，K线 ' + KLINE_INTERVAL);
        st.interval = setInterval(function(){ checkGridAndTrade(id); }, 5000);
    }
    renderStrategyCards();
}

function resetStrategy(id) {
    var st = strategyStates[id];
    if (st.running) { st.running = false; if (st.interval) { clearInterval(st.interval); st.interval = null; } }
    st.usdtPoints = INITIAL_USDT_POINTS;
    st.xauPoints = 0; st.avgCost = 0;
    st.totalTrades = 0; st.winTrades = 0; st.lossTrades = 0;
    st.maxDrawdown = 0; st.peakValue = INITIAL_USDT_POINTS; st.initialValue = INITIAL_USDT_POINTS;
    st.lastPrice = 0; st.gridLevel = 0;
    st.orders = [];
    var now = Date.now();
    st.periodStats = { '1d':{pnl:0,trades:0,lastReset:now}, '1w':{pnl:0,trades:0,lastReset:now}, '1m':{pnl:0,trades:0,lastReset:now}, 'all':{pnl:0,trades:0} };
    resetIndicatorState(st);
    addLog(id, '🔄 已重置账户与指标状态');
    renderStrategyCards();
}

