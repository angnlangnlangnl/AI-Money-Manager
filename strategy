            'FIL/USDT': { price: 5.67, change: 3.45, base: 'USDT', asset: 'FIL', label: 'FIL' },
            'APT/USDT': { price: 12.34, change: 7.89, base: 'USDT', asset: 'APT', label: 'APT' },
            'SUI/USDT': { price: 1.89, change: 4.56, base: 'USDT', asset: 'SUI', label: 'SUI' },
            'NEAR/USDT': { price: 5.67, change: -2.34, base: 'USDT', asset: 'NEAR', label: 'NEAR' },
