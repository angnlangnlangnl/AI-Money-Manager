    <script>
        // ============================================================
        //  策略交易面板逻辑 - EMA20+EMA50 趋势策略
        // ============================================================
        let strategyUsdtBalance = 10000;
        let strategyBtcBalance = 0;
        let strategyBtcPrice = 65000;
        let strategyRunning = false;
        let strategyInterval = null;
        let strategyChartData = [];
        let strategyChart = null;
        let strategyLogEntries = [];
        let currentStrategySymbol = 'BTC/USDT';
        let currentTimePeriod = '1h';
        let selectedPairs = new Set(['BTC/USDT', 'ETH/USDT', 'SOL/USDT', 'BNB/USDT', 'XRP/USDT', 'ADA/USDT', 'DOT/USDT', 'AVAX/USDT']);
        let tempSelectedPairs = new Set();
        let strategyStopLoss = 62000;
        let strategyEmaShort = 20;
        let strategyEmaLong = 50;
        let strategyPosition = 'empty';
        let lastCross = null;
        let priceHistory = [];
        let signalCheckInterval = null;

        // 所有可用交易对
        const allPairs = [
            'BTC/USDT', 'ETH/USDT', 'SOL/USDT', 'BNB/USDT', 'XRP/USDT', 'ADA/USDT', 'DOT/USDT', 'AVAX/USDT',
