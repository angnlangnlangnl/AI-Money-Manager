            'DOGE/USDT': { price: 0.156, change: 8.90, base: 'USDT', asset: 'DOGE', label: 'DOGE' },
            'SHIB/USDT': { price: 0.0000234, change: 6.78, base: 'USDT', asset: 'SHIB', label: 'SHIB' },
            'TRX/USDT': { price: 0.234, change: 1.56, base: 'USDT', asset: 'TRX', label: 'TRX' },
            'ETC/USDT': { price: 23.45, change: -1.23, base: 'USDT', asset: 'ETC', label: 'ETC' },
            'AAVE/USDT': { price: 156.78, change: 3.45, base: 'USDT', asset: 'AAVE', label: 'AAVE' },
            'MKR/USDT': { price: 2345.67, change: -0.56, base: 'USDT', asset: 'MKR', label: 'MKR' },
            'COMP/USDT': { price: 56.78, change: 1.89, base: 'USDT', asset: 'COMP', label: 'COMP' },
            'CRV/USDT': { price: 0.567, change: -2.34, base: 'USDT', asset: 'CRV', label: 'CRV' },
            'SNX/USDT': { price: 3.45, change: 4.56, base: 'USDT', asset: 'SNX', label: 'SNX' },
            'YFI/USDT': { price: 6789.01, change: 0.89, base: 'USDT', asset: 'YFI', label: 'YFI' },
        };

        // 时间周期对应的数据点数
        const periodDataPoints = {
            '1h': 24,
            '4h': 30,
            '1d': 30,
            '1m': 30
        };

        // 计算EMA
        function calculateEMA(data, period) {
            if (data.length < period) return null;
            const k = 2 / (period + 1);
            let ema = data[0];
            for (let i = 1; i < data.length; i++) {
                ema = data[i] * k + ema * (1 - k);
            }
            return ema;
        }

        function strategyAddLog(msg) {
            const time = new Date().toLocaleTimeString();
            const entry = `[${time}] ${msg}`;
            strategyLogEntries.push(entry);
            if (strategyLogEntries.length > 100) strategyLogEntries.shift();
            const box = document.getElementById('strategyLogBox');
            if (box) box.textContent = strategyLogEntries.join('\n');
            if (box) box.scrollTop = box.scrollHeight;
        }

        function strategyUpdateDisplay() {
            const total = strategyUsdtBalance + strategyBtcBalance * strategyBtcPrice;
            const initial = 10000;
            const pnl = total - initial;

            const data = pairData[currentStrategySymbol] || pairData['BTC/USDT'];
            document.getElementById('strategyHeaderPrice').textContent = '$' + strategyBtcPrice.toFixed(2);
            const headerChangeEl = document.getElementById('strategyHeaderChange');
            if (headerChangeEl) {
                headerChangeEl.textContent = (data.change >= 0 ? '+' : '') + data.change.toFixed(2) + '%';
                headerChangeEl.style.color = data.change >= 0 ? '#10b981' : '#ef4444';
            }

            document.getElementById('strategyTotalBalance').textContent = '$' + total.toFixed(2);
            document.getElementById('strategyUsdtBalance').textContent = strategyUsdtBalance.toFixed(2);
            document.getElementById('strategyBtcBalance').textContent = strategyBtcBalance.toFixed(4);
            document.getElementById('strategyStopLoss').textContent = '$' + strategyStopLoss.toFixed(2);

            const pnlEl = document.getElementById('strategyTotalPnl');
            if (pnlEl) {
                pnlEl.textContent = (pnl >= 0 ? '+' : '') + '$' + pnl.toFixed(2);
                pnlEl.style.color = pnl >= 0 ? '#10b981' : '#ef4444';
            }

            document.getElementById('strategyCurrentPrice').textContent = '$' + strategyBtcPrice.toFixed(2);
            document.getElementById('chartPairDisplay').textContent = currentStrategySymbol;
        }

        // 时间周期切换
        function strategySetTimePeriod(period, el) {
            currentTimePeriod = period;
            document.querySelectorAll('.chart-time-labels .time-label').forEach(label => {
                label.classList.remove('active');
            });
            if (el) el.classList.add('active');

            regenerateChartData(currentStrategySymbol, period);
            strategyAddLog(`📊 切换至 ${currentStrategySymbol} ${period} 视图`);
        }

        // 生成当前交易对的图表数据
        function regenerateChartData(symbol, period) {
            const data = pairData[symbol] || pairData['BTC/USDT'];
            const basePrice = data.price;
            const volatility = basePrice * 0.025;
            const numPoints = periodDataPoints[period] || 24;
            const newData = [];
            let current = basePrice * 0.97;
            for (let i = 0; i < numPoints; i++) {
                current += (Math.random() - 0.5) * volatility * 2;
                current = Math.max(basePrice * 0.85, Math.min(basePrice * 1.15, current));
                newData.push(Math.round(current * 100) / 100);
            }
            strategyChartData = newData;
            if (strategyChart) {
                strategyChart.data.datasets[0].data = strategyChartData;
                strategyChart.data.datasets[0].label = symbol;
                strategyChart.update();
            }
        }

        function strategySelectSymbol(el, symbol) {
            document.querySelectorAll('#strategySymbolList .symbol-item').forEach(s => s.classList.remove('active'));
            el.classList.add('active');
            currentStrategySymbol = symbol;

            document.getElementById('strategyAccountTitle').textContent = '📊 账户操作 (' + symbol + ')';

            const data = pairData[symbol] || pairData['BTC/USDT'];
            document.getElementById('strategyBaseLabel').textContent = data.base + ' 余额';
            document.getElementById('strategyAssetLabel').textContent = data.asset + ' 持仓';

            strategyBtcPrice = data.price;
            document.getElementById('strategyCurrentPrice').textContent = '$' + data.price.toFixed(2);
            document.getElementById('chartPairDisplay').textContent = symbol;

            document.getElementById('strategyHeaderPrice').textContent = '$' + data.price.toFixed(2);
            const headerChangeEl = document.getElementById('strategyHeaderChange');
            if (headerChangeEl) {
                headerChangeEl.textContent = (data.change >= 0 ? '+' : '') + data.change.toFixed(2) + '%';
                headerChangeEl.style.color = data.change >= 0 ? '#10b981' : '#ef4444';
            }

            regenerateChartData(symbol, currentTimePeriod);
            strategyUpdateDisplay();
            strategyAddLog('📊 切换至 ' + symbol);
        }

        function strategyUpdatePrice() {
            const volatility = 120;
            const change = (Math.random() - 0.5) * volatility * 2;
            strategyBtcPrice = Math.max(10000, strategyBtcPrice + change);
            strategyBtcPrice = Math.round(strategyBtcPrice * 100) / 100;

            priceHistory.push(strategyBtcPrice);
            if (priceHistory.length > 200) priceHistory.shift();

            document.getElementById('strategyCurrentPrice').textContent = '$' + strategyBtcPrice.toFixed(2);
            document.getElementById('strategyHeaderPrice').textContent = '$' + strategyBtcPrice.toFixed(2);

            strategyChartData.push(strategyBtcPrice);
            const maxPoints = periodDataPoints[currentTimePeriod] || 24;
            if (strategyChartData.length > maxPoints) strategyChartData.shift();
            if (strategyChart) {
                strategyChart.data.datasets[0].data = strategyChartData;
                strategyChart.update();
            }

            // 检查止损
            if (strategyBtcPrice <= strategyStopLoss && strategyBtcBalance > 0.001) {
                const sellQuantity = strategyBtcBalance;
                const sellAmount = sellQuantity * strategyBtcPrice;
                strategyBtcBalance = 0;
                strategyUsdtBalance += sellAmount;
                strategyPosition = 'empty';
                strategyAddLog(`🛑 止损触发！卖出全部 ${currentStrategySymbol.split('/')[0]} @ $${strategyBtcPrice.toFixed(2)}`);
                strategyUpdateDisplay();
            }

            strategyUpdateDisplay();
        }

        // EMA信号检测
        function checkEMASignal() {
            if (!strategyRunning) return;

            if (priceHistory.length < strategyEmaLong + 1) {
                strategyAddLog(`⚠️ 价格数据不足(${priceHistory.length}/${strategyEmaLong + 1})，跳过信号判断`);
                return;
            }

            const emaShort = calculateEMA(priceHistory, strategyEmaShort);
            const emaLong = calculateEMA(priceHistory, strategyEmaLong);

            if (emaShort === null || emaLong === null) {
                strategyAddLog('⚠️ EMA计算失败，数据不足');
                return;
            }

            let signal = null;
            const diffPercent = Math.abs(emaShort - emaLong) / emaLong * 100;

            if (diffPercent < 0.05) {
                signal = 'neutral';
            } else if (emaShort > emaLong) {
                signal = 'golden';
            } else {
                signal = 'death';
            }

            if (signal === 'neutral') {
                strategyAddLog(`⚪ 震荡状态: EMA${strategyEmaShort}=${emaShort.toFixed(2)}, EMA${strategyEmaLong}=${emaLong.toFixed(2)}, 差异${diffPercent.toFixed(3)}%`);
                return;
            }

            if (signal === lastCross) {
                strategyAddLog(`🔁 信号重复(${signal === 'golden' ? '金叉' : '死叉'})，忽略本次信号`);
                return;
            }

            lastCross = signal;

            if (signal === 'golden') {
                strategyAddLog(`📈 金叉信号: EMA${strategyEmaShort}(${emaShort.toFixed(2)}) 上穿 EMA${strategyEmaLong}(${emaLong.toFixed(2)})`);
                strategyAutoBuy();
            } else if (signal === 'death') {
                strategyAddLog(`📉 死叉信号: EMA${strategyEmaShort}(${emaShort.toFixed(2)}) 下穿 EMA${strategyEmaLong}(${emaLong.toFixed(2)})`);
                strategyAutoSell();
            }
        }

        // 自动买入
        function strategyAutoBuy() {
            if (strategyPosition === 'long') {
                strategyAddLog('⚠️ 已持有多头仓位，跳过买入');
                return;
            }

            if (strategyBtcPrice <= 0) {
                strategyAddLog('⚠️ 价格无效，跳过买入');
                return;
            }

            if (strategyUsdtBalance <= 10) {
                strategyAddLog('⚠️ USDT余额不足(<=10)，跳过买入');
                return;
            }

            const quantity = strategyUsdtBalance / strategyBtcPrice;
            if (quantity < 0.001) {
                strategyAddLog('⚠️ 买入量太小，跳过');
                return;
            }

            strategyBtcBalance += quantity;
            strategyUsdtBalance = 0;
            strategyPosition = 'long';
            strategyAddLog(`✅ 金叉全仓买入 ${quantity.toFixed(6)} ${currentStrategySymbol.split('/')[0]} @ $${strategyBtcPrice.toFixed(2)}`);
            strategyUpdateDisplay();
        }

        // 自动卖出
        function strategyAutoSell() {
            if (strategyPosition === 'empty') {
                strategyAddLog('⚠️ 空仓状态，跳过卖出');
                return;
            }

            if (strategyBtcBalance < 0.001) {
                strategyAddLog('⚠️ 持仓不足，跳过卖出');
                return;
            }

            const sellQuantity = strategyBtcBalance;
            const sellAmount = sellQuantity * strategyBtcPrice;
            strategyBtcBalance = 0;
            strategyUsdtBalance += sellAmount;
            strategyPosition = 'empty';
            strategyAddLog(`✅ 死叉全部卖出 ${sellQuantity.toFixed(6)} ${currentStrategySymbol.split('/')[0]} @ $${strategyBtcPrice.toFixed(2)}`);
            strategyUpdateDisplay();
        }

        function strategyExecuteOrder(type) {
            const assetSymbol = currentStrategySymbol.split('/')[0];
            if (type === 'buy') {
                if (strategyPosition === 'long') {
                    strategyAddLog('⚠️ 已持有多头仓位，跳过买入');
                    return;
                }
                if (strategyUsdtBalance <= 10) {
                    strategyAddLog('⚠️ USDT 余额不足，无法买入');
                    return;
                }
                const quantity = strategyUsdtBalance / strategyBtcPrice;
                if (quantity < 0.001) {
                    strategyAddLog('⚠️ 买入量太小');
                    return;
                }
                strategyBtcBalance += quantity;
                strategyUsdtBalance = 0;
                strategyPosition = 'long';
                strategyAddLog(`✅ 买入 ${quantity.toFixed(6)} ${assetSymbol} @ $${strategyBtcPrice.toFixed(2)}`);
            } else {
                if (strategyPosition === 'empty') {
                    strategyAddLog('⚠️ 空仓状态，无法卖出');
                    return;
                }
                if (strategyBtcBalance < 0.001) {
                    strategyAddLog('⚠️ ' + assetSymbol + ' 持仓不足，无法卖出');
                    return;
                }
                const sellQuantity = strategyBtcBalance;
                const sellAmount = sellQuantity * strategyBtcPrice;
                strategyBtcBalance = 0;
                strategyUsdtBalance += sellAmount;
                strategyPosition = 'empty';
                strategyAddLog(`✅ 卖出 ${sellQuantity.toFixed(6)} ${assetSymbol} @ $${strategyBtcPrice.toFixed(2)}`);
            }
            strategyUpdateDisplay();
        }

        function strategyToggle() {
            const btn = document.querySelector('.btn-strategy');
            const dot = document.getElementById('strategyStatusDot');
            const statusText = document.getElementById('strategyStatusText');

            if (strategyRunning) {
                strategyRunning = false;
                clearInterval(strategyInterval);
                clearInterval(signalCheckInterval);
                btn.textContent = '▶ 启动策略';
                dot.classList.remove('active');
                statusText.textContent = '策略已停止';
                strategyAddLog('⏹️ 策略已停止');
            } else {
                strategyRunning = true;
                lastCross = null;
                btn.textContent = '⏹ 停止策略';
                dot.classList.add('active');
                statusText.textContent = '策略运行中 (EMA趋势)';
                strategyAddLog('▶️ 策略已启动 (EMA' + strategyEmaShort + '+EMA' + strategyEmaLong + ' 趋势策略)');
                strategyAddLog('📊 等待收集 ' + (strategyEmaLong + 1) + ' 条价格数据...');

                if (priceHistory.length < strategyEmaLong + 1) {
                    for (let i = 0; i < strategyEmaLong + 5; i++) {
                        priceHistory.push(strategyBtcPrice + (Math.random() - 0.5) * 100);
                    }
                }

                signalCheckInterval = setInterval(checkEMASignal, 25000);
                strategyInterval = setInterval(strategyUpdatePrice, 5000);

                setTimeout(checkEMASignal, 1000);
            }
        }

        function strategyInitChart() {
            const canvas = document.getElementById('strategyPriceChart');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            canvas.style.width = '100%';
            canvas.style.height = '200px';

            const data = pairData['BTC/USDT'];
            const basePrice = data.price;
            const numPoints = periodDataPoints['1h'] || 24;
            const initialData = [];
            let current = basePrice * 0.97;
            for (let i = 0; i < numPoints; i++) {
                current += (Math.random() - 0.5) * basePrice * 0.025 * 2;
                current = Math.max(basePrice * 0.85, Math.min(basePrice * 1.15, current));
                initialData.push(Math.round(current * 100) / 100);
            }
            strategyChartData = initialData;

            strategyChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: Array(numPoints).fill(''),
                    datasets: [{
                        label: 'BTC/USDT',
                        data: strategyChartData,
                        borderColor: '#3b82f6',
                        backgroundColor: 'rgba(59,130,246,0.1)',
                        fill: true,
                        tension: 0.2,
                        pointRadius: 0,
                        borderWidth: 2,
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return '$' + context.parsed.y.toFixed(2);
                                }
                            }
                        }
                    },
                    scales: {
                        x: { display: false },
                        y: {
                            ticks: {
                                color: '#6a6a7a',
                                callback: function(value) { return '$' + value.toFixed(0); }
                            },
                            grid: { color: '#1a1a2a' }
                        }
                    }
                }
            });
        }

        function strategyRenderSymbols() {
            const topContainer = document.getElementById('strategySymbolList');
            if (topContainer) {
                let html = '';
                const pairsArray = Array.from(selectedPairs);
                pairsArray.forEach((symbol, index) => {
                    const activeClass = index === 0 ? 'active' : '';
                    html +=
                        `<span class="symbol-item ${activeClass}" onclick="strategySelectSymbol(this, '${symbol}')">${symbol}</span>`;
                });
                topContainer.innerHTML = html;
                if (pairsArray.length > 0) {
                    currentStrategySymbol = pairsArray[0];
                }
            }
        }

        // 打开添加交易对弹窗
        function strategyAddPair() {
            tempSelectedPairs = new Set(selectedPairs);
            document.getElementById('pairSearchInput').value = '';
            renderPairList('');
            document.getElementById('pairModalOverlay').classList.add('show');
        }

        // 关闭弹窗
        function closePairModal(e) {
            if (e && e.target !== e.currentTarget) return;
            document.getElementById('pairModalOverlay').classList.remove('show');
        }

        // 渲染交易对列表
        function renderPairList(filter) {
            const container = document.getElementById('pairListContainer');
            const filterLower = filter.toLowerCase();
            const filteredPairs = allPairs.filter(pair => pair.toLowerCase().includes(filterLower));

            if (filteredPairs.length === 0) {
                container.innerHTML = '<div class="no-results">未找到匹配的交易对</div>';
                return;
            }

            let html = '';
            filteredPairs.forEach(pair => {
                const isSelected = tempSelectedPairs.has(pair);
                const data = pairData[pair] || { price: 100, change: 0 };
                html += `
                    <div class="pair-option ${isSelected ? 'selected' : ''}" onclick="togglePairSelection('${pair}')">
                        <span class="pair-name">${pair}</span>
                        <span class="pair-price">$${data.price.toFixed(2)}</span>
                        <span class="check-icon">${isSelected ? '✓' : ''}</span>
                    </div>
                `;
            });
            container.innerHTML = html;
        }

        // 切换交易对选择
        function togglePairSelection(pair) {
            if (tempSelectedPairs.has(pair)) {
                tempSelectedPairs.delete(pair);
            } else {
                tempSelectedPairs.add(pair);
            }
            renderPairList(document.getElementById('pairSearchInput').value);
        }

        // 搜索过滤
        function filterPairList() {
            const filter = document.getElementById('pairSearchInput').value;
            renderPairList(filter);
        }

        // 确认添加
        function confirmAddPairs() {
            if (tempSelectedPairs.size === 0) {
                alert('请至少选择一个交易对');
                return;
            }
            selectedPairs = new Set(tempSelectedPairs);
            strategyRenderSymbols();
            closePairModal();
            strategyAddLog('✅ 交易对列表已更新');
        }

        // 打开参数设置弹窗
        function openParamsModal() {
            document.getElementById('paramStopLoss').value = strategyStopLoss;
            document.getElementById('paramEmaShort').value = strategyEmaShort;
            document.getElementById('paramEmaLong').value = strategyEmaLong;
            document.getElementById('paramsModalOverlay').classList.add('show');
        }

        // 关闭参数设置弹窗
        function closeParamsModal(e) {
            if (e && e.target !== e.currentTarget) return;
            document.getElementById('paramsModalOverlay').classList.remove('show');
        }

        // 保存参数
        function saveParams() {
            const stopLoss = parseFloat(document.getElementById('paramStopLoss').value);
            const emaShort = parseInt(document.getElementById('paramEmaShort').value);
            const emaLong = parseInt(document.getElementById('paramEmaLong').value);

            if (isNaN(stopLoss) || stopLoss <= 0) {
                alert('请输入有效的止损价格');
                return;
            }
            if (isNaN(emaShort) || emaShort < 5 || emaShort > 50) {
                alert('EMA短期周期应在 5-50 之间');
                return;
            }
            if (isNaN(emaLong) || emaLong < 20 || emaLong > 200) {
                alert('EMA长期周期应在 20-200 之间');
                return;
            }
            if (emaShort >= emaLong) {
                alert('EMA短期周期应小于长期周期');
                return;
            }

            strategyStopLoss = stopLoss;
            strategyEmaShort = emaShort;
            strategyEmaLong = emaLong;

            if (strategyRunning) {
                lastCross = null;
                priceHistory = [];
                strategyAddLog('⚙️ 参数已更新，信号状态已重置');
            }

            strategyUpdateDisplay();
            closeParamsModal();
            strategyAddLog(`⚙️ 参数已更新: 止损 $${stopLoss}, EMA${emaShort}/EMA${emaLong}`);
        }

        // ============================================================
        //  初始化
        // ============================================================
        document.addEventListener('DOMContentLoaded', function() {
            strategyRenderSymbols();
            strategyInitChart();

            const data = pairData['BTC/USDT'];
            strategyBtcPrice = data.price;
            currentStrategySymbol = 'BTC/USDT';
            currentTimePeriod = '1h';

            priceHistory = [];
            for (let i = 0; i < 60; i++) {
                priceHistory.push(data.price + (Math.random() - 0.5) * 100);
            }

            document.getElementById('strategyHeaderPrice').textContent = '$' + data.price.toFixed(2);
            const headerChangeEl = document.getElementById('strategyHeaderChange');
            if (headerChangeEl) {
                headerChangeEl.textContent = (data.change >= 0 ? '+' : '') + data.change.toFixed(2) + '%';
                headerChangeEl.style.color = data.change >= 0 ? '#10b981' : '#ef4444';
            }

            document.getElementById('strategyCurrentPrice').textContent = '$' + data.price.toFixed(2);
            document.getElementById('strategyAccountTitle').textContent = '📊 账户操作 (BTC/USDT)';
            document.getElementById('chartPairDisplay').textContent = 'BTC/USDT';

            regenerateChartData('BTC/USDT', '1h');
            strategyUpdateDisplay();
            strategyAddLog('✅ 策略面板已就绪');
            strategyAddLog(`📊 当前 BTC 价格: $${strategyBtcPrice.toFixed(2)}`);
            strategyAddLog(`📈 EMA策略: EMA${strategyEmaShort}+EMA${strategyEmaLong} 趋势跟踪`);

            // 暴露全局函数
            window.strategySelectSymbol = strategySelectSymbol;
            window.strategySetTimePeriod = strategySetTimePeriod;
            window.strategyExecuteOrder = strategyExecuteOrder;
            window.strategyToggle = strategyToggle;
            window.strategyAddPair = strategyAddPair;
            window.closePairModal = closePairModal;
            window.togglePairSelection = togglePairSelection;
            window.filterPairList = filterPairList;
            window.confirmAddPairs = confirmAddPairs;
            window.openParamsModal = openParamsModal;
            window.closeParamsModal = closeParamsModal;
            window.saveParams = saveParams;

            // 弹窗外部点击关闭
            document.getElementById('pairModalOverlay').addEventListener('click', function(e) {
                if (e.target === this) {
                    closePairModal();
                }
            });
            document.getElementById('paramsModalOverlay').addEventListener('click', function(e) {
                if (e.target === this) {
                    closeParamsModal();
                }
            });
        });
    </script>
</body>
</html>
