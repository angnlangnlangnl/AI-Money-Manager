<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <title>策略交易 - AI 金融助手</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <style>
        /* ===== 全局重置 ===== */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent;
        }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background: #0a0a0f;
            color: #e8e8f0;
            height: 100vh;
            overflow-y: auto;
            overflow-x: hidden;
            touch-action: manipulation;
        }
        ::-webkit-scrollbar {
            width: 3px;
        }
        ::-webkit-scrollbar-track {
            background: transparent;
        }
        ::-webkit-scrollbar-thumb {
            background: #2a2a3a;
            border-radius: 4px;
        }
        .tap-active:active {
            transform: scale(0.96);
            opacity: 0.7;
        }

        /* ===== 策略面板容器 ===== */
        #strategyPanel {
            max-width: 900px;
            width: 100%;
            margin: 0 auto;
            padding: 20px;
            min-height: 100vh;
            background: #0a0a0f;
        }

        /* ===== 返回按钮 ===== */
        .back-btn {
            cursor: pointer;
            padding: 4px 6px;
            border-radius: 6px;
            transition: background 0.2s;
            color: #8a8a9a;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: transparent;
            border: none;
            margin-bottom: 16px;
            font-size: 0;
            gap: 0;
            text-decoration: none;
        }
        .back-btn:active {
            background: #1a1a2a;
        }
        .back-btn svg {
            width: 24px;
            height: 24px;
            stroke: #8a8a9a;
            fill: none;
            stroke-width: 2;
        }

        /* ===== 顶部总收益卡片 ===== */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 16px;
            background: #12121f;
            border: 1px solid #1a1a2a;
            border-radius: 16px;
            padding: 14px 20px;
        }
        .header .total-info {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }
        .header .total-info .label {
            font-size: 14px;
            color: #6a6a7a;
        }
        .header .price-info {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 4px;
        }
        .header .price-info .price-value {
            font-size: 26px;
            font-weight: 700;
            color: #e8e8f0;
        }
        .header .price-info .price-change {
            font-size: 16px;
            font-weight: 600;
        }

        /* ===== 交易对列表 ===== */
        .symbol-bar {
            display: flex;
            align-items: center;
            width: 100%;
            border-bottom: 1px solid #1a1a2a;
            padding: 12px 0 8px 0;
            margin-bottom: 12px;
            position: relative;
        }
        .symbol-list {
            display: flex;
            gap: 18px;
            overflow-x: auto;
            overflow-y: hidden;
            scrollbar-width: thin;
            scrollbar-color: #3b82f6 #1a1a2a;
            flex: 1;
            padding-bottom: 4px;
        }
        .symbol-list::-webkit-scrollbar {
            height: 4px;
        }
        .symbol-list::-webkit-scrollbar-thumb {
            background-color: #3b82f6;
            border-radius: 2px;
        }
        .symbol-list::-webkit-scrollbar-track {
            background: #1a1a2a;
        }
        .symbol-item {
            color: #6a6a7a;
            font-size: 14px;
            font-weight: 600;
            letter-spacing: 0.5px;
            cursor: pointer;
            transition: color 0.3s ease;
            position: relative;
            white-space: nowrap;
            flex-shrink: 0;
            padding: 4px 0;
        }
        .symbol-item:hover {
            color: #9ca3af;
        }
        .symbol-item.active {
            color: #3b82f6;
        }
        .add-pair-btn {
            width: 28px;
            height: 28px;
            border: 1px solid #3b82f6;
            color: #3b82f6;
            background: transparent;
            border-radius: 50%;
            font-size: 16px;
            font-weight: 300;
            margin-left: 12px;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }
        .add-pair-btn:hover {
            background-color: #3b82f6;
            color: #0a0a0f;
        }

        /* ===== 价格走势卡片 ===== */
        .chart-container {
            background: #12121f;
            border: 1px solid #1a1a2a;
            border-radius: 16px;
            padding: 18px;
            margin-bottom: 20px;
            min-height: 260px;
            position: relative;
        }
        .chart-container .chart-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 12px;
        }
        .chart-container .chart-header .chart-title {
            color: #60a5fa;
            font-size: 16px;
            font-weight: 600;
        }
        .chart-container .chart-header .chart-pair {
            color: #6a6a7a;
            font-size: 14px;
            font-weight: 500;
            background: #1a1a2a;
            padding: 2px 12px;
            border-radius: 12px;
            border: 1px solid #2a2a3a;
        }
        .chart-container canvas {
            width: 100% !important;
            height: 200px !important;
        }
        .chart-time-labels {
            display: flex;
            justify-content: flex-end;
            gap: 6px;
            margin-top: 8px;
            padding-right: 4px;
        }
        .chart-time-labels .time-label {
            font-size: 11px;
            color: #5a5a6a;
            cursor: pointer;
            padding: 2px 10px;
            border-radius: 12px;
            transition: all 0.2s;
            border: 1px solid transparent;
        }
        .chart-time-labels .time-label:hover {
            color: #8a8a9a;
            border-color: #2a2a3a;
        }
        .chart-time-labels .time-label.active {
            color: #3b82f6;
            border-color: #3b82f6;
            background: rgba(59, 130, 246, 0.08);
        }

        /* ===== 账户操作卡片 ===== */
        .account-card {
            background: #12121f;
            border: 1px solid #1a1a2a;
            border-radius: 16px;
            padding: 18px;
            margin-bottom: 20px;
        }
        .account-card .card-title {
            color: #60a5fa;
            font-size: 16px;
            font-weight: 600;
            border-bottom: 1px solid #1a1a2a;
            padding-bottom: 10px;
            margin-bottom: 14px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .account-card .card-title .params-btn {
            background: #1a1a2a;
            color: #8a8a9a;
            border: none;
            border-radius: 6px;
            padding: 4px 12px;
            font-size: 12px;
            cursor: pointer;
            transition: background 0.2s;
        }
        .account-card .card-title .params-btn:hover {
            background: #2a2a3a;
        }
        .account-card .account-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
        }
        .account-card .account-row .label {
            font-size: 13px;
            color: #6a6a7a;
        }
        .account-card .account-row .value {
            font-size: 15px;
            font-weight: 600;
            color: #e8e8f0;
        }
        .account-card .account-row .value.btc {
            color: #fbbf24;
        }
        .account-card .account-row .value.green {
            color: #10b981;
        }
        .account-card .account-row .value.red {
            color: #ef4444;
        }
        .account-card .divider {
            border-top: 1px solid #1a1a2a;
            margin: 12px 0;
        }
        .account-card .status-indicator {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            margin-bottom: 12px;
            color: #9ca3af;
        }
        .account-card .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #6a6a7a;
        }
        .account-card .dot.active {
            background: #10b981;
            box-shadow: 0 0 8px #10b981;
        }
        .account-card .button-group {
            display: flex;
            gap: 10px;
        }
        .account-card .button-group .btn {
            flex: 1;
            text-align: center;
            padding: 10px 18px;
            border: none;
            border-radius: 8px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: opacity 0.2s;
            color: white;
        }
        .account-card .button-group .btn:hover {
            opacity: 0.85;
        }
        .account-card .button-group .btn-buy {
            background: #10b981;
        }
        .account-card .button-group .btn-sell {
            background: #ef4444;
        }
        .account-card .btn-strategy {
            background: #3b82f6;
            width: 100%;
            padding: 10px 18px;
            border: none;
            border-radius: 8px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: opacity 0.2s;
            color: white;
            margin-top: 10px;
        }
        .account-card .btn-strategy:hover {
            opacity: 0.85;
        }
        .account-card .current-price {
            margin-top: 10px;
            font-size: 13px;
            color: #6a6a7a;
        }
        .account-card .stop-loss-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
        }
        .account-card .stop-loss-row .label {
            font-size: 13px;
            color: #6a6a7a;
        }
        .account-card .stop-loss-row .value {
            font-size: 15px;
            font-weight: 600;
            color: #ef4444;
        }

        /* ===== 策略规则介绍卡片 ===== */
        .rules-card {
            background: #12121f;
            border: 1px solid #1a1a2a;
            border-radius: 16px;
            padding: 18px;
            margin-bottom: 20px;
        }
        .rules-card .rules-title {
            color: #60a5fa;
            font-size: 16px;
            font-weight: 600;
            border-bottom: 1px solid #1a1a2a;
            padding-bottom: 10px;
            margin-bottom: 14px;
        }
        .rules-card .rule-item {
            display: flex;
            align-items: flex-start;
            gap: 8px;
            margin-bottom: 10px;
            font-size: 13px;
            color: #9ca3af;
            line-height: 1.6;
        }
        .rules-card .rule-item .rule-icon {
            flex-shrink: 0;
            width: 20px;
            text-align: center;
        }
        .rules-card .rule-item .rule-text strong {
            color: #e8e8f0;
        }

        /* ===== 交易日志卡片 ===== */
        .log-card {
            background: #12121f;
            border: 1px solid #1a1a2a;
            border-radius: 16px;
            padding: 18px;
            margin-bottom: 20px;
        }
        .log-card .card-title {
            color: #60a5fa;
            font-size: 16px;
            font-weight: 600;
            border-bottom: 1px solid #1a1a2a;
            padding-bottom: 10px;
            margin-bottom: 14px;
        }
        .log-box {
            background: #0a0a12;
            border: 1px solid #1a1a2a;
            border-radius: 8px;
            padding: 12px;
            height: 160px;
            overflow-y: auto;
            font-family: 'Consolas', monospace;
            font-size: 13px;
            line-height: 1.5;
            white-space: pre-wrap;
            word-break: break-all;
            color: #9ca3af;
        }

        /* ===== 添加交易对弹窗样式 ===== */
        .pair-modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.7);
            z-index: 2000;
            display: none;
            align-items: center;
            justify-content: center;
            animation: fadeIn 0.2s ease;
        }
        .pair-modal-overlay.show {
            display: flex;
        }
        .pair-modal {
            background: #12121f;
            border: 1px solid #1a1a2a;
            border-radius: 16px;
            padding: 20px;
            width: 90%;
            max-width: 420px;
            max-height: 70vh;
            display: flex;
            flex-direction: column;
            animation: slideUp 0.3s ease;
        }
        .pair-modal .modal-title {
            color: #60a5fa;
            font-size: 16px;
            font-weight: 600;
            text-align: center;
            margin-bottom: 16px;
        }
        .pair-modal .search-input {
            width: 100%;
            background: #0a0a12;
            border: 1px solid #1a1a2a;
            border-radius: 8px;
            padding: 10px 12px;
            font-size: 14px;
            color: #e8e8f0;
            outline: none;
            margin-bottom: 12px;
            transition: border-color 0.2s;
        }
        .pair-modal .search-input:focus {
            border-color: #3b82f6;
        }
        .pair-modal .search-input::placeholder {
            color: #5a5a6a;
        }
        .pair-modal .pair-list {
            flex: 1;
            overflow-y: auto;
            margin-bottom: 12px;
        }
        .pair-modal .pair-list::-webkit-scrollbar {
            width: 4px;
        }
        .pair-modal .pair-list::-webkit-scrollbar-thumb {
            background: #2a2a3a;
            border-radius: 4px;
        }
        .pair-modal .pair-option {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 12px;
            border-radius: 8px;
            cursor: pointer;
            transition: background 0.2s;
            margin-bottom: 4px;
        }
        .pair-modal .pair-option:hover {
            background: #1a1a2a;
        }
        .pair-modal .pair-option.selected {
            background: #1a2a3a;
            border: 1px solid #3b82f6;
        }
        .pair-modal .pair-option .pair-name {
            font-size: 14px;
            font-weight: 600;
            color: #e8e8f0;
        }
        .pair-modal .pair-option .pair-price {
            font-size: 13px;
            color: #6a6a7a;
        }
        .pair-modal .pair-option .check-icon {
            color: #3b82f6;
            font-size: 18px;
        }
        .pair-modal .modal-buttons {
            display: flex;
            gap: 10px;
        }
        .pair-modal .modal-buttons .btn {
            flex: 1;
            padding: 10px;
            border: none;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: opacity 0.2s;
        }
        .pair-modal .modal-buttons .btn-confirm {
            background: #3b82f6;
            color: #0a0a0f;
        }
        .pair-modal .modal-buttons .btn-confirm:hover {
            opacity: 0.85;
        }
        .pair-modal .modal-buttons .btn-cancel {
            background: #1a1a2a;
            color: #6a6a7a;
        }
        .pair-modal .modal-buttons .btn-cancel:hover {
            opacity: 0.85;
        }
        .pair-modal .no-results {
            text-align: center;
            padding: 20px;
            color: #5a5a6a;
            font-size: 14px;
        }

        /* ===== 参数设置弹窗样式 ===== */
        .params-modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.7);
            z-index: 2000;
            display: none;
            align-items: center;
            justify-content: center;
            animation: fadeIn 0.2s ease;
        }
        .params-modal-overlay.show {
            display: flex;
        }
        .params-modal {
            background: #12121f;
            border: 1px solid #1a1a2a;
            border-radius: 16px;
            padding: 20px;
            width: 90%;
            max-width: 380px;
            display: flex;
            flex-direction: column;
            animation: slideUp 0.3s ease;
        }
        .params-modal .modal-title {
            color: #60a5fa;
            font-size: 16px;
            font-weight: 600;
            text-align: center;
            margin-bottom: 16px;
        }
        .params-modal .param-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 12px;
        }
        .params-modal .param-row .param-label {
            font-size: 13px;
            color: #6a6a7a;
        }
        .params-modal .param-row .param-input {
            width: 120px;
            background: #0a0a12;
            border: 1px solid #1a1a2a;
            border-radius: 6px;
            padding: 6px 10px;
            font-size: 13px;
            color: #e8e8f0;
            outline: none;
            text-align: right;
            transition: border-color 0.2s;
        }
        .params-modal .param-row .param-input:focus {
            border-color: #3b82f6;
        }
        .params-modal .modal-buttons {
            display: flex;
            gap: 10px;
            margin-top: 8px;
        }
        .params-modal .modal-buttons .btn {
            flex: 1;
            padding: 10px;
            border: none;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: opacity 0.2s;
        }
        .params-modal .modal-buttons .btn-confirm {
            background: #3b82f6;
            color: #0a0a0f;
        }
        .params-modal .modal-buttons .btn-confirm:hover {
            opacity: 0.85;
        }
        .params-modal .modal-buttons .btn-cancel {
            background: #1a1a2a;
            color: #6a6a7a;
        }
        .params-modal .modal-buttons .btn-cancel:hover {
            opacity: 0.85;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
            }
            to {
                opacity: 1;
            }
        }
        @keyframes slideUp {
            from {
                transform: translateY(30px);
                opacity: 0.5;
            }
            to {
                transform: translateY(0);
                opacity: 1;
            }
        }
    </style>
</head>
<body>
    <!-- ============================================================ -->
    <!-- 策略交易面板 -->
    <!-- ============================================================ -->
    <div id="strategyPanel">
        <!-- 返回键 -->
        <a class="back-btn" href="index.html" title="返回">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"/>
            </svg>
        </a>

        <!-- 1. 顶部总收益卡片 -->
        <div class="header">
            <div class="total-info">
                <span class="label">总收益</span>
            </div>
            <div class="price-info">
                <span class="price-value" id="strategyHeaderPrice">$65,432.10</span>
                <span class="price-change" id="strategyHeaderChange" style="color:#10b981;">+3.21%</span>
            </div>
        </div>

        <!-- 2. 交易对选择栏 -->
        <div class="symbol-bar">
            <div class="symbol-list" id="strategySymbolList">
                <!-- 由JS渲染 -->
            </div>
            <button class="add-pair-btn" onclick="strategyAddPair()">+</button>
        </div>

        <!-- 3. 价格走势卡片 -->
        <div class="chart-container">
            <div class="chart-header">
                <span class="chart-title">📈 价格走势</span>
                <span class="chart-pair" id="chartPairDisplay">BTC/USDT</span>
            </div>
            <canvas id="strategyPriceChart" height="200"></canvas>
            <!-- 时间周期提示标记 -->
            <div class="chart-time-labels" id="chartTimeLabels">
                <span class="time-label active" data-period="1h" onclick="strategySetTimePeriod('1h', this)">1小时</span>
                <span class="time-label" data-period="4h" onclick="strategySetTimePeriod('4h', this)">4小时</span>
                <span class="time-label" data-period="1d" onclick="strategySetTimePeriod('1d', this)">日线</span>
                <span class="time-label" data-period="1m" onclick="strategySetTimePeriod('1m', this)">月线</span>
            </div>
        </div>

        <!-- 4. 账户操作卡片 -->
        <div class="account-card">
            <div class="card-title">
                <span id="strategyAccountTitle">📊 账户操作 (BTC/USDT)</span>
                <button class="params-btn" onclick="openParamsModal()">⚙️ 参数设置</button>
            </div>

            <!-- 账户信息 -->
            <div class="account-row">
                <span class="label">总资产</span>
                <span class="value" id="strategyTotalBalance">$10,000.00</span>
            </div>
            <div class="account-row">
                <span class="label" id="strategyBaseLabel">USDT 余额</span>
                <span class="value" id="strategyUsdtBalance">10,000.00</span>
            </div>
            <div class="account-row">
                <span class="label" id="strategyAssetLabel">BTC 持仓</span>
                <span class="value btc" id="strategyBtcBalance">0.0000</span>
            </div>
            <!-- 止损价格行 -->
            <div class="stop-loss-row">
                <span class="label">止损 价格</span>
                <span class="value" id="strategyStopLoss">$62,000.00</span>
            </div>
            <div class="account-row">
                <span class="label">总盈亏</span>
                <span class="value" id="strategyTotalPnl" style="color:#10b981;">+$0.00</span>
            </div>

            <div class="divider"></div>

            <!-- 状态指示器 -->
            <div class="status-indicator">
                <span class="dot active" id="strategyStatusDot"></span>
                <span id="strategyStatusText">策略已停止</span>
            </div>

            <!-- 操作按钮 -->
            <div class="button-group">
                <button class="btn btn-buy" onclick="strategyExecuteOrder('buy')">买入</button>
                <button class="btn btn-sell" onclick="strategyExecuteOrder('sell')">卖出</button>
            </div>
            <button class="btn-strategy" onclick="strategyToggle()">
                ▶ 启动策略
            </button>
            <div class="current-price">
                当前价格: <span id="strategyCurrentPrice">--</span>
            </div>
        </div>

        <!-- 5. 策略规则介绍 -->
        <div class="rules-card">
            <div class="rules-title">📋 EMA20+EMA50 趋势策略规则</div>
            <div class="rule-item">
                <span class="rule-icon">📈</span>
